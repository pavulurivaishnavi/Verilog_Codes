#! /c/iverilog/bin/vvp
:ivl_version "0.9.7 " "(v0_9_7)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_011E3C80 .scope module, "fd_by_four_tb" "fd_by_four_tb" 2 1;
 .timescale 0 0;
v011A3320_0 .var "clk", 0 0;
v011A8600_0 .net "clk_out", 0 0, v011A4208_0; 1 drivers
v011A8658_0 .var "reset", 0 0;
S_011A4128 .scope module, "DUT" "fd_by_four" 2 4, 3 1, S_011E3C80;
 .timescale 0 0;
v011A41B0_0 .net "clk", 0 0, v011A3320_0; 1 drivers
v011A4208_0 .var "clk_out", 0 0;
v011A3270_0 .var "q", 0 0;
v011A32C8_0 .net "reset", 0 0, v011A8658_0; 1 drivers
E_011A9198 .event posedge, v011A32C8_0, v011A3270_0;
E_011A8EB8 .event posedge, v011A32C8_0, v011A41B0_0;
    .scope S_011A4128;
T_0 ;
    %wait E_011A8EB8;
    %load/v 8, v011A32C8_0, 1;
    %jmp/0xz  T_0.0, 8;
    %set/v v011A3270_0, 0, 1;
    %jmp T_0.1;
T_0.0 ;
    %load/v 8, v011A3270_0, 1;
    %inv 8, 1;
    %set/v v011A3270_0, 8, 1;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_011A4128;
T_1 ;
    %wait E_011A9198;
    %load/v 8, v011A32C8_0, 1;
    %jmp/0xz  T_1.0, 8;
    %set/v v011A4208_0, 0, 1;
    %jmp T_1.1;
T_1.0 ;
    %load/v 8, v011A4208_0, 1;
    %inv 8, 1;
    %set/v v011A4208_0, 8, 1;
T_1.1 ;
    %jmp T_1;
    .thread T_1;
    .scope S_011E3C80;
T_2 ;
    %set/v v011A3320_0, 0, 1;
T_2.0 ;
    %delay 5, 0;
    %load/v 8, v011A3320_0, 1;
    %inv 8, 1;
    %set/v v011A3320_0, 8, 1;
    %jmp T_2.0;
    %end;
    .thread T_2;
    .scope S_011E3C80;
T_3 ;
    %vpi_call 2 12 "$dumpfile", "fd_by_four_tb.vcd";
    %vpi_call 2 13 "$dumpvars", 1'sb0, S_011E3C80;
    %end;
    .thread T_3;
    .scope S_011E3C80;
T_4 ;
    %vpi_call 2 18 "$display", "frequency divider by 4 simulation";
    %vpi_call 2 19 "$monitor", "time = %0t, clk = %b, reset = %b, clk_out = %b", $time, v011A3320_0, v011A8658_0, v011A8600_0;
    %set/v v011A8658_0, 0, 1;
    %delay 5, 0;
    %set/v v011A8658_0, 0, 1;
    %delay 10, 0;
    %set/v v011A8658_0, 0, 1;
    %delay 10, 0;
    %set/v v011A8658_0, 1, 1;
    %delay 10, 0;
    %set/v v011A8658_0, 0, 1;
    %delay 10, 0;
    %set/v v011A8658_0, 0, 1;
    %delay 10, 0;
    %set/v v011A8658_0, 0, 1;
    %delay 10, 0;
    %set/v v011A8658_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 28 "$finish";
    %end;
    .thread T_4;
# The file index is used to find the file name in the following table.
:file_names 4;
    "N/A";
    "<interactive>";
    "fd_by_four_tb.v";
    "fd_by_four.v";
