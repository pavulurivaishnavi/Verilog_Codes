#! /c/iverilog/bin/vvp
:ivl_version "0.9.7 " "(v0_9_7)";
:vpi_time_precision + 0;
:vpi_module "system";
:vpi_module "v2005_math";
:vpi_module "va_math";
S_012C3B08 .scope module, "frequency_divider_tb" "frequency_divider_tb" 2 1;
 .timescale 0 0;
v012C8218_0 .var "clk", 0 0;
v012C8270_0 .net "clk_out", 0 0, v012C3338_0; 1 drivers
v012C82C8_0 .var "reset", 0 0;
S_012C3258 .scope module, "DUT" "frequency_divider" 2 4, 3 1, S_012C3B08;
 .timescale 0 0;
v012C32E0_0 .net "clk", 0 0, v012C8218_0; 1 drivers
v012C3338_0 .var "clk_out", 0 0;
v012C81C0_0 .net "reset", 0 0, v012C82C8_0; 1 drivers
E_01121E30 .event posedge, v012C32E0_0;
    .scope S_012C3258;
T_0 ;
    %wait E_01121E30;
    %load/v 8, v012C81C0_0, 1;
    %jmp/0xz  T_0.0, 8;
    %ix/load 0, 1, 0;
    %assign/v0 v012C3338_0, 0, 0;
    %jmp T_0.1;
T_0.0 ;
    %load/v 8, v012C3338_0, 1;
    %inv 8, 1;
    %ix/load 0, 1, 0;
    %assign/v0 v012C3338_0, 0, 8;
T_0.1 ;
    %jmp T_0;
    .thread T_0;
    .scope S_012C3B08;
T_1 ;
    %set/v v012C8218_0, 0, 1;
T_1.0 ;
    %delay 5, 0;
    %load/v 8, v012C8218_0, 1;
    %inv 8, 1;
    %set/v v012C8218_0, 8, 1;
    %jmp T_1.0;
    %end;
    .thread T_1;
    .scope S_012C3B08;
T_2 ;
    %vpi_call 2 12 "$dumpfile", "frequency_divider_tb.vcd";
    %vpi_call 2 13 "$dumpvars", 1'sb0, S_012C3B08;
    %end;
    .thread T_2;
    .scope S_012C3B08;
T_3 ;
    %vpi_call 2 18 "$display", "frequency divider by 2 simulation";
    %vpi_call 2 19 "$monitor", "time = %0t, clk = %b, reset = %b, clk_out = %b", $time, v012C8218_0, v012C82C8_0, v012C8270_0;
    %set/v v012C82C8_0, 0, 1;
    %delay 5, 0;
    %set/v v012C82C8_0, 0, 1;
    %delay 10, 0;
    %set/v v012C82C8_0, 0, 1;
    %delay 10, 0;
    %set/v v012C82C8_0, 1, 1;
    %delay 10, 0;
    %set/v v012C82C8_0, 0, 1;
    %delay 10, 0;
    %set/v v012C82C8_0, 0, 1;
    %delay 10, 0;
    %set/v v012C82C8_0, 0, 1;
    %delay 10, 0;
    %vpi_call 2 27 "$finish";
    %end;
    .thread T_3;
